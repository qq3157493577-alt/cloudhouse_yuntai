set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

# Add ARM GCC's bin directory to PATH; do not commit a machine-specific path.
find_program(ARM_GCC arm-none-eabi-gcc REQUIRED)
get_filename_component(ARM_GCC_BIN_DIR "${ARM_GCC}" DIRECTORY)
find_program(ARM_OBJCOPY arm-none-eabi-objcopy HINTS "${ARM_GCC_BIN_DIR}" NO_DEFAULT_PATH REQUIRED)
find_program(ARM_SIZE arm-none-eabi-size HINTS "${ARM_GCC_BIN_DIR}" NO_DEFAULT_PATH REQUIRED)

set(CMAKE_C_COMPILER "${ARM_GCC}")
set(CMAKE_ASM_COMPILER "${ARM_GCC}")
set(CMAKE_OBJCOPY "${ARM_OBJCOPY}" CACHE FILEPATH "ARM objcopy")
set(CMAKE_SIZE "${ARM_SIZE}" CACHE FILEPATH "ARM image size utility")

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
